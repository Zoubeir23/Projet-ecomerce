# Configuration de base de données
DATABASE_URL=sqlite:///db.sqlite3
# Pour PostgreSQL : postgresql://user:password@localhost:5432/ecommerce_db

# Clés de sécurité Django
SECRET_KEY=your-secret-key-here
DEBUG=True

# Configuration Redis
REDIS_URL=redis://localhost:6379/0

# Configuration Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# Configuration Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Configuration PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox  # ou 'live' pour production

# Configuration OpenAI pour le chatbot
OPENAI_API_KEY=sk-your-openai-api-key

# Configuration AWS S3 (optionnel)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your_bucket_name
AWS_S3_REGION_NAME=eu-west-3

# Configuration Sentry (monitoring)
SENTRY_DSN=https://your-sentry-dsn

# Domaines autorisés
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000